// kitty-os bar. Docs: man 5 waybar
{
    "layer": "top",
    "position": "top",
    "height": 36,
    "margin-top": 6,
    "margin-left": 14,
    "margin-right": 14,
    "spacing": 6,
    "modules-left": ["custom/cat", "sway/workspaces", "sway/mode", "sway/window"],
    "modules-center": ["clock"],
    "modules-right": ["custom/catkeys", "tray", "pulseaudio", "network", "cpu", "memory", "battery"],

    "custom/cat": {
        "exec": "catmode waybar",
        "return-type": "json",
        "interval": 60,
        "on-click": "catmode next",
        "on-click-right": "notify-send -a catfact '🐾 Cat fact' \"$(catfact)\""
    },
    "custom/catkeys": {
        "exec": "catkeys waybar",
        "return-type": "json",
        "interval": 2,
        "on-click": "catkeys unlock",
        "on-click-right": "catkeys pause"
    },
    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },
    "sway/mode": {
        "format": "{}"
    },
    "sway/window": {
        "max-length": 50
    },
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%A %d %B %Y}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": {"default": ["󰕿", "󰖀", "󰕾"]},
        "on-click": "pavucontrol"
    },
    "network": {
        "format-wifi": "󰖩 {essid}",
        "format-ethernet": "󰈀 wired",
        "format-disconnected": "󰖪 offline",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
    },
    "cpu": {
        "format": "󰍛 {usage}%",
        "interval": 5
    },
    "memory": {
        "format": "󰘚 {percentage}%",
        "interval": 5
    },
    "battery": {
        "states": {"warning": 25, "critical": 10},
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
    },
    "tray": {
        "spacing": 8
    }
}
